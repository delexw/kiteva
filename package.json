{
  "name": "local-video-agent",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "music:setup": "node --import tsx scripts/setup-instruments.ts",
    "speech:setup:pocket": "node --import tsx scripts/setup-pocket-tts.ts",
    "speech:setup": "node --import tsx scripts/setup-speech.ts",
    "dev": "node --import tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx src/server/index.ts",
    "test": "vitest run",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "examples": "node --import tsx scripts/generate-style-examples.ts",
    "verify:browser": "node --import tsx scripts/verify-browser.ts",
    "examples:fallback": "node --import tsx scripts/bootstrap-examples.ts",
    "examples:videos": "node --import tsx scripts/generate-style-videos.ts claude",
    "previews:webm": "node --import tsx scripts/migrate-preview-webm.ts",
    "films:copies": "node --import tsx scripts/migrate-playback-copies.ts",
    "caveman": "node --import tsx scripts/caveman.ts",
    "caveman:setup": "npm run caveman -- setup --install",
    "caveman:stats": "npm run caveman -- stats --plain",
    "windows:check": "node --import tsx scripts/verify-native-render.ts --windows",
    "native:check": "node --import tsx scripts/verify-native-render.ts",
    "speech:setup:pocket:zh": "node --import tsx scripts/setup-pocket-tts-zh.ts",
    "capture:worker": "node --import tsx scripts/capture-worker.ts"
  },
  "dependencies": {
    "@ant-design/x": "^2.9.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.303",
    "@caveman-ai/cli": "4.0.1",
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^8.3.0",
    "@iarna/toml": "2.2.5",
    "@json-render/core": "^0.21.0",
    "@json-render/react": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openai/codex": "0.162.1",
    "@openai/codex-sdk": "latest",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@remotion/cli": "latest",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tonejs/midi": "^2.0.28",
    "@typesafe-ai/sdk": "latest",
    "ai": "^7.0.137",
    "antd": "^6.6.6",
    "chroma-js": "^3.2.0",
    "class-variance-authority": "^0.7.1",
