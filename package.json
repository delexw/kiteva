    "dotenv": "latest",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.6.0",
    "fflate": "latest",
    "gsap": "^3.14.0",
    "hyperframes": "0.8.144",
    "i18next": "^26.5.2",
    "ipaddr.js": "latest",
    "lucide-react": "latest",
    "mammoth": "latest",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "minisearch": "7.2.0",
    "motion": "latest",
    "multiplane": "0.3.10",
    "nanoid": "^6.0.2",
