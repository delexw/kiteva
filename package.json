    "puppeteer-core": "^25.13.0",
    "radix-ui": "^1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.1.0",
    "react-router-dom": "^7.18.4",
    "remotion": "latest",
    "rfc6902": "^5.3.0",
    "roughjs": "latest",
    "sharp": "latest",
    "shell-quote": "^1.12.0",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "three": "latest",
    "use-stick-to-bottom": "^1.1.6",
    "yauzl": "3.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.80",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chroma-js": "latest",
    "@types/d3-polygon": "3.0.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
