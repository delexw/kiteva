# Local experiments and generated project artifacts
/exports/
/renders/
/snapshots/
/videos/
/work/

# Workspace outputs never belong to the application.
/outputs/

# Dependencies, builds, local data, credentials, and temporary tooling state
node_modules/
dist/
.data/
user-data/
.env
.env.*
!.env.example
.DS_Store
.claude/
!/.claude/
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/cut-release/
.codex/
.cache/
.vite/
.idea/
.vscode/
.test-results/
test-results/
playwright-report/
coverage/
*.log
*.tsbuildinfo

# Downloaded speech model weights and voice states (setup recreates these)
/models/qwen3-tts/
/models/qwen3-tts-base/
/models/kokoro/
/models/pocket-tts/
/models/pocket-tts-zh/

# Upstream authoring skills are installed and refreshed at launch.
/skills/
/.agents/

# Downloaded local instrument bank and upstream license (music:setup recreates these).
/models/instruments/

# Per-project runtime homes, temporary files and caches
.runtime/

# Python runtime caches and local environments
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime-generated style summaries; already tracked bundled summaries stay versioned.
/assets/style-summaries/
