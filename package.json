    "@xmldom/xmldom": "0.8.15",
    "oxfmt": "latest",
    "oxlint": "latest",
    "playwright": "latest",
    "tailwindcss": "^4.3.3",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "yazl": "3.3.1"
  },
  "overrides": {
    "multiplane": {
      "three": "$three"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
