# Copy to .env.local. Never put secrets in browser code.
TYPESAFE_API_KEY=
VIDEO_AGENT_PORT=4317
VIDEO_AGENT_WEB_PORT=4319
VIDEO_CODEX_MODEL=gpt-6.1-sol
VIDEO_CLAUDE_MODEL=claude-opus-5-5
# SDKs can reuse local CLI login. API credentials are optional alternatives:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional local capabilities; leave unset if unavailable.
# VIDEO_BLENDER_PATH=/path/to/blender
# VIDEO_BROWSER_PATH=/path/to/chromium

# App-local Caveman compression and cost trial (all Claude/Codex SDK calls).
VIDEO_CAVEMAN_ENABLED=true
VIDEO_CAVEMAN_PORT=4321

# Optional local instrument renderer (independent of narration).
# VIDEO_FLUIDSYNTH_PATH=/path/to/fluidsynth
# VIDEO_INSTRUMENT_SOUNDFONT=/path/to/instruments.sf2
