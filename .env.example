# install.sh creates .env.local from this file. Add your JEV key:
TYPESAFE_API_KEY=

# Claude/Codex reuse your local CLI login. Alternatively, set provider API keys:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Ports, models and installed local tools use app defaults; no paths are needed.
# Advanced settings: docs/application-guide.md
# Recording/worker overrides: docs/openscreen-worker.md
# Audio Studio overrides: src/server/agents/capabilities/README.md
